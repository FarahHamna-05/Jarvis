# ==============================================================================
# SupplyGuard AI (Ripple) — Environment Variables & SendGrid API Credentials
# ==============================================================================

# Database Passwords (defaults to local dev instances)
DB_PASSWORD=Dhanush1
MONGODB_URI=mongodb://localhost:27017/supplyguard_mongo

# ------------------------------------------------------------------------------
# 1. Option A: Direct Gmail SMTP Delivery (Original Gmail -> Supplier Gmail)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail address and 16-character App Password below:
GMAIL_USERNAME=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 2. Option B: SendGrid API Delivery (Alternative)
# ------------------------------------------------------------------------------
# 1. Sign up for a free SendGrid account at https://signup.sendgrid.com (free tier includes 100 emails/day)
# 2. REQUIRED: Complete "Single Sender Verification" under Settings -> Sender Authentication in SendGrid
# 3. Create an API key with "Mail Send" permissions under Settings -> API Keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=alerts@supplyguard.ai
SENDGRID_FROM_NAME=SupplyGuard Autonomous Procurement

# Ollama Local AI Reasoning (Optional - has automatic deterministic fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
